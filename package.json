    "expo-audio": "~55.0.18",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.19",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
